QDRANT_KEY=
CLUSTER_ENDPOINT=
COLLECTION_NAME=

# Nomes dos vetores na coleção (named vectors), na ordem das dimensões.
# Esquema atual da coleção: v_produto, v_servico, v_descricao, v_publico, v_cliente (1536 dim, Cosine) + sparse bm25_complete_profile.
# Exemplo para 5 vetores:
# QDRANT_DIMENSION_KEYS=produto,servico,descricao,publico,cliente
# QDRANT_VECTOR_NAMES=v_produto,v_servico,v_descricao,v_publico,v_cliente

# Chaves de payload usadas em filter e filter_not (POST /search).
# Keyword (match exato / match.any): modelo_negocio, cidade, uf, nome_empresa, cnpj.
# Se não definir, a API usa: modelo_negocio,cidade,uf,nome_empresa,cnpj.
# QDRANT_PAYLOAD_KEYS=modelo_negocio,cidade,uf,nome_empresa,cnpj

# Chaves com índice full-text no Qdrant (filtro por match.text). Ex.: descricao, endereco, publico, site, email, certificacoes.
# Se não definir, a API usa: descricao,endereco,publico,site,email,certificacoes (compatível com o esquema da coleção).
# QDRANT_PAYLOAD_KEYS_TEXT=descricao,endereco,publico,site,email,certificacoes

# BM25 (busca híbrida): vetor esparso na coleção e modelo de inferência
# QDRANT_BM25_VECTOR_NAME=bm25_texto
# QDRANT_BM25_MODEL=qdrant/bm25
# Payloads que alimentam o vetor BM25 (informativo; listado em GET /config)
# QDRANT_BM25_PAYLOAD_KEYS=descricao,segmento,categoria,subcategoria
# BM25_CANDIDATES_MULTIPLIER=5   (candidatos = limit * N antes da fusão; default 5)
# RRF_K=60                       (RRF: 1/(k+rank); default 60)

# Opcional
# SEARCH_TIMEOUT_SECONDS=120
# PORT=3000
# HOST=0.0.0.0
# LOG_QDRANT_REQUESTS=1   # loga no console o body de cada POST ao Qdrant (inspeção de filtros); use para debug

# Pipeline de vetorização (POST /pipeline/run, GET /pipeline/dashboard)
# OPENAI_API_KEY=          # obrigatório para o pipeline
# PIPELINE_DB_QUERY_MAX=25000   # linhas por SELECT (1k–100k); lotes maiores usam várias leituras até o limite da execução
# OPENAI_EMBED_BATCH_SIZE=200   # textos por request OpenAI (1–2048; maior = menos requests)
# PIPELINE_CHUNK_SIZE=200       # empresas por super-chunk (50–1000)
# UPSERT_BATCH_SIZE=500         # pontos por batch no Qdrant no pipeline (1–1000)
# QDRANT_UPSERT_WAIT=false      # true = espera indexação (consistência); false = throughput máximo
# QDRANT_UPSERT_CONCURRENCY=3   # requisições de upsert em paralelo no pipeline (1–8; free tier 2–4)
# QDRANT_UPSERT_MAX_BATCH=1000  # máximo pontos por request (500–2000)

# PostgreSQL (fetch + mark-vectorized)
# DB_URL=postgres://user:pass@host:5432/dbname
# DB_POOL_SIZE=10
# MARK_VECTORIZED_CHUNK_SIZE=1000
# MARK_VECTORIZED_CONCURRENCY=8
